<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 this process's ANSI code page (Windows 10 1903 and later), so
     the command line, fopen and every other narrow-string file API take the
     same UTF-8 paths as assimp and GLFW. Without it, a path with any
     character outside the legacy code page, in the file name or in a folder
     above it, cannot be opened. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
